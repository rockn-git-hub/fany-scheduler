{
  "name": "fany-scheduler-trigger",
  "account_id": "5e24ef42729457dcacdcf21d8f97c5bf",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // UTC 23:27 / 11:27 = 日本時間 08:27 / 20:27
  // UTC平日 01:00 / 02:00 / 05:00 / 06:00 / 07:00 / 08:00 = 日本時間平日 10:00 / 11:00 / 14:00 / 15:00 / 16:00 / 17:00
  "triggers": {
    "crons": ["27 23 * * *", "27 11 * * *", "0 1,2,5,6,7,8 * * 1-5"]
  },
  "observability": { "enabled": true }
}

{
  "name": "fany-scheduler-trigger",
  "account_id": "5e24ef42729457dcacdcf21d8f97c5bf",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // UTC 23:00 / 11:00 = 日本時間 08:00 / 20:00
  // 水飲み通知: 日本時間平日 10:30 / 11:30 / 14:00 / 15:30 / 17:00
  "triggers": {
    "crons": ["0 23 * * *", "0 11 * * *", "30 1,2,6 * * 1-5", "0 5,8 * * 1-5"]
  },
  "observability": { "enabled": true }
}
